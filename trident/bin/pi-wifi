#!/usr/bin/env bash
# pi-wifi: manage Wi-Fi networks via NetworkManager.
#
#   pi-wifi                          show current Wi-Fi status (default)
#   pi-wifi --status                 same as above
#   pi-wifi --list                   list saved + visible networks
#   pi-wifi --ssid SSID --pass PW    ADD (or update) a saved profile; does NOT switch
#   pi-wifi --ssid SSID --open       ...declaring it an open network
#   pi-wifi --ssid SSID --auto       let it connect on its own, below the home AP
#   pi-wifi --ssid SSID --no-auto    back to manual (--switch only)
#   pi-wifi --ssid SSID --priority N NetworkManager autoconnect-priority
#   pi-wifi --switch NAME  [--force] switch to a saved profile (activate it)
#   pi-wifi --connect NAME [--force] alias of --switch
#   [--iface IFACE]                  interface (default wlan0)
#
# Adding a profile never touches the current link (so it is always safe).
# Switching is refused if the interface is already connected, unless --force,
# to protect the priority link (e.g. pi5-w-1). A new profile is autoconnect=no
# (manual via --switch); the priority network keeps auto-connecting on its own.
# A new profile with no --pass is an open network. NAME may be the profile name
# or its SSID.
#
# --auto is for a network the deck should find by itself -- a phone hotspot,
# where the alternative is a radio sitting unconnected away from the AP until
# somebody types --switch. It ranks the profile NEGATIVE rather than raising
# the AP's: higher wins in NetworkManager, the AP sits at 0, and the AP profile
# belongs to netplan (/etc/netplan/90-NM-*.yaml) rather than to
# /etc/NetworkManager/system-connections, so not editing it is worth a minus.
#
# On an EXISTING profile, saying nothing about security does nothing to it.
# This used to run `wifi-sec.key-mgmt none`, which strips WPA from a working
# network without saying so; --open is now how that is asked for.
#
# This is the counterpart of pi-net, and the split is deliberate:
#
#   pi-wifi   which networks exist -- add one, list them, choose between them
#   pi-net    what the current link is doing -- status, reconnect, timed off-grid
#
# nmcli and sudo come from the environment (PI_WIFI_NMCLI, PI_WIFI_SUDO) for the
# same reason pi-lang takes its systemctl that way: the interesting behaviour is
# which nmcli command gets built, and a test must be able to see that without a
# radio, without root, and without changing the machine it runs on.
set -u

NMCLI="${PI_WIFI_NMCLI:-nmcli}"
# Only read after a failed switch, to say what actually happened rather than
# guessing. NetworkManager's own error is second-order and misleads.
JOURNALCTL="${PI_WIFI_JOURNALCTL:-journalctl}"
# -n so a headless deck fails fast instead of waiting on a password prompt
# nobody is there to answer. Empty when already root, or when a test says so.
if [ -n "${PI_WIFI_SUDO+x}" ]; then
  SUDO="$PI_WIFI_SUDO"
elif [ "$(id -u)" = "0" ]; then
  SUDO=""
else
  SUDO="sudo -n"
fi

IFACE=wlan0
SSID=""
PASS=""
TARGET=""
ACTION=""
FORCE=0
AUTO=""          # "", "yes" or "no" -- empty means "not asked about"
PRIO=""
OPEN=0
# Below the home AP's 0, so the AP profile never has to be edited.
DEFAULT_AUTO_PRIORITY=-10

while [ $# -gt 0 ]; do
  case "$1" in
    --ssid)             SSID="${2:-}"; shift 2 || shift;;
    --pass|--password)  PASS="${2:-}"; shift 2 || shift;;
    --switch|--connect) TARGET="${2:-}"; ACTION=switch; shift 2 || shift;;
    --iface)            IFACE="${2:-}"; shift 2 || shift;;
    --force)            FORCE=1; shift;;
    --auto)             AUTO=yes; shift;;
    --no-auto)          AUTO=no;  shift;;
    --priority)         PRIO="${2:-}"; shift 2 || shift;;
    --open)             OPEN=1; shift;;
    --status)           ACTION=status; shift;;
    --list)             ACTION=list;   shift;;
    -h|--help)          ACTION=help;   shift;;
    *) echo "pi-wifi: unknown argument: $1" >&2; exit 2;;
  esac
done

# Default action: --ssid given => add a profile; otherwise => status.
if [ -z "$ACTION" ]; then
  if [ -n "$SSID" ]; then ACTION=add; else ACTION=status; fi
fi

case "$ACTION" in
  help)
    cat <<'EOF'
pi-wifi - manage Wi-Fi via NetworkManager

  pi-wifi                          current status (default)
  pi-wifi --status
  pi-wifi --list                   saved + visible networks
  pi-wifi --ssid SSID --pass PW    add/update a saved profile (does NOT switch)
  pi-wifi --ssid SSID --open       add/update it as an open network
  pi-wifi --ssid SSID --auto       let it connect on its own (below the home AP)
  pi-wifi --ssid SSID --no-auto    back to manual (--switch only)
  pi-wifi --ssid SSID --priority N set autoconnect-priority explicitly
  pi-wifi --switch NAME [--force]   switch to a saved profile (activate)
  pi-wifi --connect NAME [--force]  alias of --switch
  [--iface IFACE]                  default wlan0

Adding a profile never disrupts the current connection. Switching does, so it
is refused while already connected unless --force (protects e.g. pi5-w-1).
A new profile is autoconnect=no (use --switch); the priority network keeps
auto-connecting. NAME may be a profile name or an SSID. Back to home AP:
  pi-wifi --switch pi5-w-1 --force

--auto suits a phone hotspot: away from the AP the radio would otherwise sit
unconnected until somebody types --switch. It ranks the profile negative, so
the AP still wins at home and the AP's own profile is left alone.

On an existing profile, saying nothing about security does nothing to it.
--open is how an open network is declared.

See also: pi-net (status / reconnect / timed off-grid on the current link).
EOF
    exit 0;;

  status)
    $NMCLI -t -f GENERAL.CONNECTION,GENERAL.STATE,IP4.ADDRESS device show "$IFACE" 2>/dev/null \
      || { echo "pi-wifi: no such interface: $IFACE" >&2; exit 1; }
    exit 0;;

  list)
    echo "== saved Wi-Fi profiles =="
    # AUTOCONNECT as well as its priority: a profile at priority 0 with
    # autoconnect=no is never considered at all, and the priority column on its
    # own reads as though it were merely ranked equal to the others.
    $NMCLI -f NAME,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY connection show 2>/dev/null \
      | awk 'NR==1 || /wifi|wireless/'
    echo "== visible networks ($IFACE) =="
    $SUDO $NMCLI -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null | head -20
    exit 0;;

  add)
    [ -z "$SSID" ] && { echo "pi-wifi: --ssid is required" >&2; exit 2; }

    # The autoconnect half, shared by both branches. Empty AUTO means the
    # caller said nothing about it, which for an existing profile means leave
    # it as it is.
    auto_args=""
    case "$AUTO" in
      yes) auto_args="connection.autoconnect yes connection.autoconnect-priority ${PRIO:-$DEFAULT_AUTO_PRIORITY}";;
      no)  auto_args="connection.autoconnect no"
           [ -n "$PRIO" ] && auto_args="$auto_args connection.autoconnect-priority $PRIO";;
      *)   [ -n "$PRIO" ] && auto_args="connection.autoconnect-priority $PRIO";;
    esac

    if $NMCLI -t -f NAME connection show 2>/dev/null | grep -qxF "$SSID"; then
      # Existing profile: change only what was actually asked for. Security is
      # touched only by --pass or --open, never by their absence.
      sec_args=""
      if [ -n "$PASS" ]; then
        sec_args="wifi-sec.key-mgmt wpa-psk wifi-sec.psk $PASS"
      elif [ "$OPEN" -eq 1 ]; then
        sec_args="wifi-sec.key-mgmt none"
      fi
      if [ -z "$sec_args" ] && [ -z "$auto_args" ]; then
        echo "pi-wifi: \"$SSID\" already exists and nothing was asked for." >&2
        echo "pi-wifi: give --pass, --open, --auto, --no-auto or --priority." >&2
        exit 2
      fi
      # shellcheck disable=SC2086  # both halves are deliberately word-split
      $SUDO $NMCLI connection modify "$SSID" $sec_args $auto_args \
        && echo "pi-wifi: updated profile \"$SSID\"${sec_args:+ (security)}${auto_args:+ (autoconnect)}"
      exit $?
    fi

    # New profile. Manual unless told otherwise, so a network typed in from the
    # field cannot outrank the AP at the next boot.
    [ -z "$auto_args" ] && auto_args="connection.autoconnect no"
    if [ -n "$PASS" ]; then
      # shellcheck disable=SC2086
      $SUDO $NMCLI connection add type wifi con-name "$SSID" ifname "$IFACE" ssid "$SSID" \
        $auto_args -- wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PASS" \
        && echo "pi-wifi: added profile \"$SSID\" (not switched; pi-wifi --switch \"$SSID\" --force)"
    else
      # shellcheck disable=SC2086
      $SUDO $NMCLI connection add type wifi con-name "$SSID" ifname "$IFACE" ssid "$SSID" \
        $auto_args \
        && echo "pi-wifi: added open profile \"$SSID\" (not switched)"
    fi
    exit $?;;

  switch)
    [ -z "$TARGET" ] && { echo "pi-wifi: --switch needs a profile name or SSID" >&2; exit 2; }
    # Guard: protect the current link unless --force.
    if [ "$FORCE" -ne 1 ]; then
      line=$($NMCLI -t -f DEVICE,STATE,CONNECTION device status 2>/dev/null \
               | awk -F: -v i="$IFACE" '$1==i{print; exit}')
      st=$(printf '%s' "$line" | cut -d: -f2)
      cn=$(printf '%s' "$line" | cut -d: -f3-)
      if [ "$st" = "connected" ]; then
        echo "already connected to Wi-Fi (\"$cn\" on $IFACE); use --force to switch to \"$TARGET\"" >&2
        exit 1
      fi
    fi
    # Resolve TARGET: a profile name, else a profile whose SSID matches.
    CONN="$TARGET"
    if ! $NMCLI -t -f NAME connection show 2>/dev/null | grep -qxF "$TARGET"; then
      while IFS=: read -r name typ; do
        case "$typ" in *wireless*|*wifi*)
          s=$($NMCLI -t -g 802-11-wireless.ssid connection show "$name" 2>/dev/null)
          [ "$s" = "$TARGET" ] && { CONN="$name"; break; };;
        esac
      done < <($NMCLI -t -f NAME,TYPE connection show 2>/dev/null)
    fi
    echo "pi-wifi: switching $IFACE -> \"$CONN\" ..."
    $SUDO $NMCLI connection up "$CONN" ifname "$IFACE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      echo "pi-wifi: $IFACE = $($NMCLI -t -g IP4.ADDRESS device show "$IFACE" 2>/dev/null | head -1)"
    else
      echo "pi-wifi: switch failed (rc=$rc)" >&2
      # Say which of the two failures this was. Reporting "is it a saved
      # profile?" for a profile that is plainly in --list sends the search in
      # exactly the wrong direction, which is what happened on 2026-08-28.
      if ! $NMCLI -t -f NAME connection show 2>/dev/null | grep -qxF "$CONN"; then
        echo "pi-wifi: \"$TARGET\" is not among the saved connections (pi-wifi --list)" >&2
      else
        echo "pi-wifi: the profile \"$CONN\" exists, so that is not what is missing." >&2
        # NetworkManager asks for new secrets when association times out, so
        # "Secrets were required, but not provided" arrives for failures that
        # have nothing to do with the key. On a headless deck there is no
        # secret agent to answer, which turns any association failure into
        # what reads like a password problem.
        echo "pi-wifi: NetworkManager requests new secrets whenever association fails, and" >&2
        echo "pi-wifi: with no agent to answer that surfaces as \"Secrets were required\"." >&2
        echo "pi-wifi: It is not evidence of a wrong passphrase. Look at the radio first:" >&2
        ev=$($JOURNALCTL --since "-3min" --no-pager -o cat 2>/dev/null \
             | grep -E "CTRL-EVENT-ASSOC-REJECT|CTRL-EVENT-SSID-TEMP-DISABLED|association took too long" \
             | tail -4)
        if [ -n "$ev" ]; then
          printf '%s\n' "$ev" | sed 's/^/pi-wifi:   /' >&2
          # The BSSID in a reject is whichever one the supplicant was still
          # dealing with -- often the network being left, not the one being
          # joined, whose SSID then gets temp-disabled as collateral.
          echo "pi-wifi:   (a BSSID above may belong to the network being left, not this one)" >&2
        else
          echo "pi-wifi:   (no association events in the journal for the last 3 minutes)" >&2
        fi
      fi
    fi
    exit $rc;;
esac

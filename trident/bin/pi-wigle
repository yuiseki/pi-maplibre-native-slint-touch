#!/usr/bin/env python3
"""pi-wigle: ask WiGLE where this machine is, using the Wi-Fi it can see.

    pi-wigle                     -> 34.385300 132.455300  (7/31 APs, 62 m)
    pi-wigle --json
    pi-wigle --publish           ...and write it where pi-gps would have
    pi-wigle --scan-only         just show what the radio can see
    pi-wigle --no-net            answer from the cache alone

A GPS receiver indoors reports fix=0 with one satellite in view. That is not a
fault; it is what the sky looks like from inside a building, and no amount of
sitting by the window fixes it. The deck then falls back to a configured home,
which is right at home and wrong in a hotel in another city -- and being
confidently wrong about where you are is worse than saying nothing.

The access points are a second sky, and they are densest exactly where the
first one is blocked. WiGLE maps BSSIDs to positions, so the scan that finds no
satellites finds thirty landmarks.

**A key is required.** WiGLE issues one per account at
https://wigle.net/account -- the pair shown there as "API Name" and "API
Token". Put it in one of these, as a single `name:token` line:

    $PI_WIGLE_KEY                 (the value itself, for a one-off)
    /etc/default/pi-wigle         PI_WIGLE_KEY=name:token
    ~/.config/pi-wigle/key        name:token
    ~/.env                        WIGLE_API_ENCODED=  (or _NAME= and _TOKEN=)

The token is never printed, not even by --json, and never written to the cache.

**The cache format is the firmware's**, deliberately: the Cardputer running
m5-cardputer-offgrid-tiny-map surveys the same BSSIDs on foot, and this keeps
one side's work readable by the other. Misses are cached too -- access points
do not move, and an unlisted one would otherwise be looked up on every scan,
against a daily quota that is not large.
"""
import argparse
import base64
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

WIGLE_URL = "https://api.wigle.net/api/v2/network/search?netid=%s"
CACHE = os.environ.get("PI_WIGLE_CACHE",
                       os.path.expanduser("~/.cache/pi-wigle"))
GPS_OUT = os.environ.get("PI_WIGLE_GPS_OUT", "/dev/shm/pi-gps")
# A real receiver republishes at 1 Hz, so anything this fresh means one is
# attached and publishing. Writing over it would be a downgrade.
GPS_FRESH_S = 5.0
# Written as the sixth field of the position file, so pi-mesh can tell a
# trilaterated position from one it wrote itself out of the node's own fix.
SOURCE = "wigle"
UA = "pi-wigle (+https://github.com/yuiseki/pi-maplibre-native-slint-touch)"


# ---- pure parts -------------------------------------------------------------

def normalize_bssid(s):
    """`AA:BB:CC:DD:EE:FF` -> `aabbccddeeff`, or None if it is not one.

    Accepts `:`, `-`, none, and nmcli's backslash-escaped `\\:`.
    """
    if not s:
        return None
    t = s.replace("\\", "").replace(":", "").replace("-", "").strip().lower()
    if len(t) != 12 or any(c not in "0123456789abcdef" for c in t):
        return None
    return t


def bssid_to_netid(bare):
    """Bare hex -> `AA:BB:CC:DD:EE:FF`, which is what WiGLE will accept.

    Bare hex is refused: the reply is HTTP 200 carrying
    `success:false, "BSSID/MAC fails validation"`, which reads exactly like
    "not in the database" and is not. The cache keeps the bare form (the
    firmware's cache is laid out that way), so the two are kept apart on
    purpose rather than by accident.
    """
    b = normalize_bssid(bare)
    if not b:
        return None
    return ":".join(b[i:i + 2] for i in range(0, 12, 2)).upper()


def quality_to_dbm(q):
    """nmcli's 0-100 back to dBm.

    wpa_supplicant computes `quality = 2 * (dBm + 100)` and clamps to 0..100,
    so this inverts exactly through the middle and saturates at the ends --
    which is all the information the scan carried in the first place.
    """
    q = max(0, min(100, int(q)))
    return q // 2 - 100


def parse_scan(text):
    """nmcli -t -f BSSID,SIGNAL,FREQ,SSID output -> [(bssid, dbm), ...].

    Strongest first, so a truncated lookup spends its quota on the APs that
    matter most to the answer.
    """
    aps = []
    for line in (text or "").splitlines():
        # The BSSID's own colons are escaped, so unescape after splitting on
        # the unescaped ones.
        parts = re.split(r"(?<!\\):", line)
        if len(parts) < 2:
            continue
        b = normalize_bssid(parts[0])
        if not b:
            continue
        try:
            q = int(parts[1])
        except ValueError:
            continue
        aps.append((b, quality_to_dbm(q)))
    aps.sort(key=lambda a: -a[1])
    return aps


def estimate(aps):
    """Centroid weighted by 10^(rssi/20). aps: [(lat, lon, rssi), ...].

    The same weighting the firmware uses, kept identical on purpose: the two
    should not disagree about where the same scan puts you.
    """
    if not aps:
        return None
    wsum = lat = lon = 0.0
    for a_lat, a_lon, rssi in aps:
        wgt = math.pow(10.0, rssi / 20.0)
        wsum += wgt
        lat += a_lat * wgt
        lon += a_lon * wgt
    if wsum <= 0:
        return None
    return (lat / wsum, lon / wsum)


def spread_m(aps, lat, lon):
    """Rough scatter of the contributing APs, in metres. An honest error bar.

    Not a confidence interval -- just how far apart the landmarks are. A tight
    cluster of five APs and one stray on the far side of town produce very
    different numbers, and the caller deserves to see which they got.
    """
    if not aps:
        return 0.0
    worst = 0.0
    for a_lat, a_lon, _ in aps:
        dlat = (a_lat - lat) * 111320.0
        dlon = (a_lon - lon) * 111320.0 * math.cos(math.radians(lat))
        worst = max(worst, math.hypot(dlat, dlon))
    return worst


def parse_response(text):
    """WiGLE's JSON -> {ok, total, has_pos, lat, lon}."""
    out = {"ok": False, "total": 0, "has_pos": False, "lat": 0.0, "lon": 0.0}
    try:
        d = json.loads(text or "")
    except (ValueError, TypeError):
        return out
    if not isinstance(d, dict) or "totalResults" not in d:
        return out
    out["ok"] = True
    try:
        out["total"] = int(d.get("totalResults") or 0)
    except (TypeError, ValueError):
        out["total"] = 0
    for r in (d.get("results") or []):
        if not isinstance(r, dict):
            continue
        # A network WiGLE knows of but has never located comes back with null
        # coordinates. Knowing of it is not knowing where it is.
        if r.get("trilat") is None or r.get("trilong") is None:
            continue
        try:
            out["lat"] = float(r["trilat"])
            out["lon"] = float(r["trilong"])
            out["has_pos"] = True
        except (TypeError, ValueError):
            continue
        break
    return out


def parse_key(text):
    """`name:token` -> (name, token), or None. Split at the first colon only."""
    if not text:
        return None
    t = text.strip()
    if ":" not in t:
        return None
    name, token = t.split(":", 1)
    name, token = name.strip(), token.strip()
    if not name or not token:
        return None
    return (name, token)


def parse_encoded(text):
    """WiGLE's "Encoded for use" value -> (name, token).

    The account page hands out the pair already base64-encoded, which is
    exactly what the Authorization header carries. Taking it verbatim removes
    the step where the two halves get transcribed in the wrong order.
    """
    if not text:
        return None
    try:
        raw = base64.b64decode(text.strip(), validate=True).decode("utf-8")
    except Exception:
        return None
    return parse_key(raw)


def key_from_env_file(path):
    """Pull a key out of a shell-style env file.

    Either WIGLE_API_ENCODED on its own, or WIGLE_API_NAME with
    WIGLE_API_TOKEN. `export` and quotes are tolerated because that is what
    these files look like in practice.
    """
    vals = {}
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:].strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                vals[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        return None
    enc = vals.get("WIGLE_API_ENCODED")
    if enc:
        k = parse_encoded(enc)
        if k:
            return k
    name = vals.get("WIGLE_API_NAME")
    token = vals.get("WIGLE_API_TOKEN")
    if name and token:
        return (name.strip(), token.strip())
    return None


# ---- cache, in the firmware's format ----------------------------------------

def cache_path(root, bssid):
    return os.path.join(root, bssid[0], bssid[:2], bssid + ".txt")


def format_cache(hit, lat, lon):
    return ("1 %.7f %.7f\n" % (lat, lon)) if hit else "0\n"


def parse_cache(line):
    if not line:
        return None
    f = line.split()
    if not f:
        return None
    if f[0] == "0":
        return (False, 0.0, 0.0)
    if f[0] != "1" or len(f) < 3:
        return None
    try:
        return (True, float(f[1]), float(f[2]))
    except ValueError:
        return None


def cache_get(root, bssid):
    try:
        with open(cache_path(root, bssid)) as fh:
            return parse_cache(fh.readline())
    except OSError:
        return None


def cache_put(root, bssid, hit, lat, lon):
    p = cache_path(root, bssid)
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as fh:
            fh.write(format_cache(hit, lat, lon))
    except OSError:
        pass          # a cache that cannot be written is still a working tool


# ---- the parts that touch the world -----------------------------------------

def load_key():
    v = os.environ.get("PI_WIGLE_KEY")
    if v:
        k = parse_key(v)
        if k:
            return k
    # Its own file rather than a shell profile: this is a credential, and the
    # place it lives should be as narrow as what it unlocks.
    for path, prefix in (("/etc/default/pi-wigle", "PI_WIGLE_KEY="),
                         (os.path.expanduser("~/.config/pi-wigle/key"), None)):
        try:
            with open(path) as fh:
                for line in fh:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if prefix:
                        if not line.startswith(prefix):
                            continue
                        line = line[len(prefix):].strip().strip('"').strip("'")
                    k = parse_key(line)
                    if k:
                        return k
        except OSError:
            continue
    # Last, because a general-purpose env file is the least specific place a
    # credential can live -- but it is where this machine already keeps it.
    for path in (os.environ.get("PI_WIGLE_ENV", ""),
                 os.path.expanduser("~/.env")):
        if path:
            k = key_from_env_file(path)
            if k:
                return k
    return None


def scan(iface):
    cmd = ["nmcli", "-t", "-f", "BSSID,SIGNAL,FREQ,SSID",
           "device", "wifi", "list", "--rescan", "yes"]
    if iface:
        cmd += ["ifname", iface]
    # A scan needs root on most setups; without it nmcli still prints the
    # cached list, which is stale but not useless.
    for argv in ([ "sudo", "-n" ] + cmd, cmd):
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=45)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout
    return ""


def query(bssid, key, timeout):
    """One BSSID against WiGLE. Returns (parsed, http_status_or_None)."""
    netid = bssid_to_netid(bssid)
    if not netid:
        return None, None
    req = urllib.request.Request(WIGLE_URL % urllib.parse.quote(netid))
    auth = base64.b64encode(("%s:%s" % key).encode()).decode()
    req.add_header("Authorization", "Basic " + auth)
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", UA)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return parse_response(r.read().decode("utf-8", "replace")), r.status
    except urllib.error.HTTPError as e:
        return None, e.code
    except (urllib.error.URLError, OSError):
        return None, None


def gps_is_live(path, now=None):
    """True if something is already publishing a real fix here."""
    try:
        age = (now or time.time()) - os.path.getmtime(path)
    except OSError:
        return False
    return age < GPS_FRESH_S


def publish(path, lat, lon):
    """Write the position where pi-gps would have, and sign it.

    The first five fields are pi-gps's, so pi-gps-track and everything
    downstream need not know which sky the answer came from. fix=1 with zero
    satellites is the honest description: a position, from no satellites.

    The sixth field names the writer, and it is not decoration. pi-mesh is the
    only process that may tell the Meshtastic node where it is, and it must
    refuse to send back a position that came from the node itself -- otherwise
    a measured fix becomes a hand-set one that never expires. It cannot tell
    the difference from five numbers, so this one says. Readers that want five
    fields are unaffected; they index the ones they know.
    """
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("%.6f %.6f %d %d %d %s\n" % (lat, lon, 1, 0, 0, SOURCE))
    os.replace(tmp, path)


def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--iface", default=os.environ.get("PI_WIGLE_IFACE", ""),
                    help="wireless interface (default: nmcli's choice)")
    ap.add_argument("--max", type=int, default=12, metavar="N",
                    help="look up at most N access points, strongest first "
                         "(default 12; the daily quota is finite)")
    ap.add_argument("--timeout", type=float, default=15.0)
    ap.add_argument("--no-net", action="store_true",
                    help="answer from the cache alone, asking WiGLE nothing")
    ap.add_argument("--scan-only", action="store_true",
                    help="print what the radio sees and stop")
    ap.add_argument("--publish", action="store_true",
                    help="write the position to %s, where pi-gps would have. "
                         "Refused while a real receiver is publishing there"
                         % GPS_OUT)
    ap.add_argument("--force", action="store_true",
                    help="publish even then")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--cache", default=CACHE)
    args = ap.parse_args()

    aps = parse_scan(scan(args.iface))
    if args.scan_only:
        for b, dbm in aps:
            print("%s %4d dBm" % (b, dbm))
        print("%d access points" % len(aps))
        return 0
    if not aps:
        print("pi-wigle: no access points visible", file=sys.stderr)
        return 1

    key = None if args.no_net else load_key()
    if key is None and not args.no_net:
        print("pi-wigle: no API key. Put `name:token` in $PI_WIGLE_KEY, "
              "/etc/default/pi-wigle or ~/.config/pi-wigle/key "
              "(get one at https://wigle.net/account), or use --no-net",
              file=sys.stderr)
        return 2

    located, asked, cached, misses = [], 0, 0, 0
    status = None
    for bssid, dbm in aps:
        c = cache_get(args.cache, bssid)
        if c is not None:
            cached += 1
            hit, lat, lon = c
            if hit:
                located.append((lat, lon, dbm))
            else:
                misses += 1
            continue
        if args.no_net or asked >= args.max:
            continue
        r, status = query(bssid, key, args.timeout)
        asked += 1
        if r is None:
            # A failed request says nothing about the AP, so nothing is cached.
            # 401 will not fix itself by asking again with the same key.
            if status == 401:
                print("pi-wigle: WiGLE rejected the key (401)", file=sys.stderr)
                return 2
            if status == 429:
                print("pi-wigle: WiGLE quota exhausted (429); "
                      "cached answers still work", file=sys.stderr)
                break
            continue
        if not r["ok"]:
            # success:false means the request was wrong, not that the access
            # point is unknown. Caching that as a miss would bake the mistake
            # in and hide it behind "not in WiGLE" forever after.
            continue
        cache_put(args.cache, bssid, r["has_pos"], r["lat"], r["lon"])
        if r["has_pos"]:
            located.append((r["lat"], r["lon"], dbm))
        else:
            misses += 1

    pos = estimate(located)
    if pos is None:
        print("pi-wigle: none of the %d visible access points are in WiGLE"
              % len(aps), file=sys.stderr)
        return 1
    lat, lon = pos
    spread = spread_m(located, lat, lon)

    published = False
    if args.publish:
        if gps_is_live(GPS_OUT) and not args.force:
            print("pi-wigle: %s is being written by a real receiver; "
                  "not overwriting it (use --force)" % GPS_OUT, file=sys.stderr)
        else:
            publish(GPS_OUT, lat, lon)
            published = True

    if args.json:
        print(json.dumps({"lat": round(lat, 6), "lon": round(lon, 6),
                          "used": len(located), "seen": len(aps),
                          "asked": asked, "from_cache": cached,
                          "not_in_wigle": misses,
                          "spread_m": round(spread, 1),
                          "published": published}, ensure_ascii=False))
    else:
        print("%.6f %.6f  (%d/%d APs, spread %.0f m%s)"
              % (lat, lon, len(located), len(aps), spread,
                 ", published" if published else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())

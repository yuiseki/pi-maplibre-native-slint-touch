#!/usr/bin/env python3
"""pi-poi: put what is around a place onto the map.

    pi-poi cafe                     -> around wherever the map is now
    pi-poi cafe hiroshima           -> around a named place
    pi-poi cafe 34.39 132.45        -> around a coordinate
    pi-poi clear                    -> take them off again

This is the thing behind "show cafes on map". It asks the Overpass running on
this machine and writes the answer into the marker feed the map already reads,
so nothing about the map has to change.
"""
import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "pi-hear"))
sys.path.insert(0, "/home/yuiseki/src/pi-hear")
import geo  # noqa: E402

# The environment wins; the file is the default. Read here rather than relying
# on systemd's EnvironmentFile, which only reaches a unit's own process -- and
# this is run from the voice loop and from a shell.
_CONF = {}
try:
    _CONF = geo.read_conf(os.environ.get("PI_POI_CONF", "/etc/default/pi-poi"))
except Exception:                                  # noqa: BLE001
    pass


def _cfg(name, default):
    return os.environ.get(name) or _CONF.get(name) or default


OVERPASS = os.environ.get("PI_POI_OVERPASS", "http://127.0.0.1:8002")
NOMINATIM = os.environ.get("PI_GEOCODE_URL", "http://127.0.0.1:8001")
MARKERS = os.environ.get("PI_POI_MARKERS", "/dev/shm/pi-mesh-nodes")
FLYTO = os.environ.get("PI_MAP_FLYTO", "/dev/shm/pi-map-flyto")
RADIUS = int(_cfg("PI_POI_RADIUS", "1500"))
GPS = os.environ.get("PI_POI_GPS", "/dev/shm/pi-gps-lastfix")
# A fallback position for a deck with no GPS fix, "lat lon". Unset by default:
# an unset home means "say you do not know", which is better than showing
# someone cafes in a city they have never been to.
HOME = _cfg("PI_POI_HOME", "")


def ask_overpass(query, base=OVERPASS, timeout=90):
    url = base.rstrip("/") + "/api/interpreter"
    data = urllib.parse.urlencode({"data": query}).encode()
    with urllib.request.urlopen(url, data=data, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def ask_nominatim(query, base=NOMINATIM, timeout=20):
    url = base.rstrip("/") + "/search?" + urllib.parse.urlencode(
        {"q": query, "format": "jsonv2", "limit": 10})
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")





def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("category", help="cafe, restaurant, toilet, ... or 'clear'")
    ap.add_argument("where", nargs="*", help="a place name, or lat lon")
    ap.add_argument("--here", action="store_true",
                    help="around the deck itself, not where the map is looking")
    ap.add_argument("--radius", type=int, default=RADIUS, help="metres")
    ap.add_argument("--limit", type=int, default=200)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.category == "clear":
        open(MARKERS, "w").close()
        print("cleared")
        return 0

    lat = lon = None
    if len(args.where) >= 2:
        try:
            lat, lon = float(args.where[0]), float(args.where[1])
        except ValueError:
            lat = lon = None
    if lat is None and args.where:
        place = geo.parse_nominatim(ask_nominatim(" ".join(args.where)))
        if place is None:
            print("pi-poi: no such place: %s" % " ".join(args.where),
                  file=sys.stderr)
            return 1
        lat, lon = place.lat, place.lon
        with open(FLYTO, "w") as fh:
            fh.write(place.flyto_line() + "\n")
    source = "given"
    if lat is None and args.here:
        # Skip the map's last flyTo: "cafes near me" means the ground under the
        # deck, and the map may have been sent somewhere else entirely.
        found = geo.where_now(flyto=None, gps=GPS, home=HOME)
        if found is None:
            print("pi-poi: no recent GPS fix and no PI_POI_HOME; cannot tell "
                  "where 'here' is", file=sys.stderr)
            return 1
        lat, lon, source = found
    if lat is None:
        here = geo.where_now(flyto=FLYTO, gps=GPS, home=HOME)
        if here is None:
            print("pi-poi: nowhere to look -- the map has not been anywhere, "
                  "there is no GPS fix, and PI_POI_HOME is unset. "
                  "Name a place.", file=sys.stderr)
            return 1
        lat, lon, source = here

    try:
        query = geo.overpass_query(args.category, lat, lon, args.radius)
    except ValueError as exc:
        print("pi-poi: %s" % exc, file=sys.stderr)
        return 2

    body = ask_overpass(query)
    lines = geo.marker_lines(body, int(time.time()), limit=args.limit)
    with open(MARKERS, "w") as fh:
        fh.write(lines + ("\n" if lines else ""))

    n = len(lines.splitlines()) if lines else 0
    if args.json:
        print(json.dumps({"category": args.category, "lat": lat, "lon": lon,
                          "radius": args.radius, "count": n,
                          "from": source}))
    else:
        print("%d %s around %.4f %.4f (r=%dm, from %s)"
              % (n, args.category, lat, lon, args.radius, source))
    return 0


if __name__ == "__main__":
    sys.exit(main())

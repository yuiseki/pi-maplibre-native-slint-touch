#!/usr/bin/env python3
"""pi-poi: put what is around a place onto the map.

    pi-poi cafe                     -> around wherever the map is now
    pi-poi cafe hiroshima           -> around a named place
    pi-poi cafe 34.39 132.45        -> around a coordinate
    pi-poi clear                    -> take them off again

This is the thing behind "show cafes on map". It asks the Overpass running on
this machine and writes the answer into the marker feed the map already reads,
so nothing about the map has to change.

Two things it does beyond fetching:

**It moves the camera to the answer.** A search whose results sit outside the
current view is indistinguishable from one that found nothing, and "show
hotels" at street zoom finds hotels you cannot see.

**It keeps one category alongside another.** Asking for hotels and then cafes
leaves both on the map, in different colours, because that is what asking for
the second one on top of the first means. Searching the same category again
replaces just that category. The per-category blocks are kept in their own file
(PI_POI_LAYERS) and the marker feed is rewritten from it, so the feed stays the
single flat thing the map reads.
"""
import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "pi-hear"))
# Appended, not inserted: when this runs from a checkout, the copy beside
# it above must win. Ahead of it, the installed copy shadowed the repo's
# and the tests silently exercised whatever was last deployed.
sys.path.append("/home/yuiseki/src/pi-hear")
import geo  # noqa: E402

# The environment wins; the file is the default. Read here rather than relying
# on systemd's EnvironmentFile, which only reaches a unit's own process -- and
# this is run from the voice loop and from a shell.
_CONF = {}
try:
    _CONF = geo.read_conf(os.environ.get("PI_POI_CONF", "/etc/default/pi-poi"))
except Exception:                                  # noqa: BLE001
    pass


def _cfg(name, default):
    return os.environ.get(name) or _CONF.get(name) or default


OVERPASS = os.environ.get("PI_POI_OVERPASS", "http://127.0.0.1:8002")
NOMINATIM = os.environ.get("PI_GEOCODE_URL", "http://127.0.0.1:8001")
MARKERS = os.environ.get("PI_POI_MARKERS", "/dev/shm/pi-mesh-nodes")
# What is on the map, per category, so that adding one does not erase the last.
# In /dev/shm with the feed it feeds: both are "what is on screen right now"
# and neither should survive a reboot.
LAYERS = os.environ.get("PI_POI_LAYERS", "/dev/shm/pi-poi-layers.json")
FLYTO = os.environ.get("PI_MAP_FLYTO", "/dev/shm/pi-map-flyto")
RADIUS = int(_cfg("PI_POI_RADIUS", "1500"))
# How close the fit may get. The basemap stops at 14, so past that its tiles
# are stretched -- the markers stay sharp, and a dense search fills the screen
# rather than sitting in a knot in the middle of it. Raise it to trade a soft
# basemap for markers you can tell apart.
MAX_FIT_ZOOM = int(_cfg("PI_POI_MAX_ZOOM", "14"))
GPS = os.environ.get("PI_POI_GPS", "/dev/shm/pi-gps-lastfix")
# A fallback position for a deck with no GPS fix, "lat lon". Unset by default:
# an unset home means "say you do not know", which is better than showing
# someone cafes in a city they have never been to.
HOME = _cfg("PI_POI_HOME", "")


def ask_overpass(query, base=OVERPASS, timeout=90):
    url = base.rstrip("/") + "/api/interpreter"
    data = urllib.parse.urlencode({"data": query}).encode()
    with urllib.request.urlopen(url, data=data, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def ask_nominatim(query, base=NOMINATIM, timeout=20):
    url = base.rstrip("/") + "/search?" + urllib.parse.urlencode(
        {"q": query, "format": "jsonv2", "limit": 10})
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")





def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("category", help="cafe, restaurant, toilet, ... or 'clear'")
    ap.add_argument("where", nargs="*", help="a place name, or lat lon")
    ap.add_argument("--here", action="store_true",
                    help="around the deck itself, not where the map is looking")
    ap.add_argument("--radius", type=int, default=RADIUS, help="metres")
    ap.add_argument("--limit", type=int, default=200)
    ap.add_argument("--keep", type=float, default=0.8,
                    help="fraction of the markers the view must cover; the "
                         "rest are outliers and are allowed off screen "
                         "(1.0 = fit every one)")
    ap.add_argument("--max-zoom", type=int, default=MAX_FIT_ZOOM,
                    help="how close the fit may get (the basemap stops at 14; "
                         "beyond that its tiles stretch but the markers "
                         "separate)")
    ap.add_argument("--no-fit", action="store_true",
                    help="leave the camera alone instead of fitting the results")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    # Whether --radius was actually given, so that sizing a named place does
    # not silently override the caller.
    radius_given = any(a == "--radius" or a.startswith("--radius=")
                       for a in sys.argv[1:])

    if args.category == "clear":
        # Everything the user put on the map, and nothing else. The Meshtastic
        # node feed is not a search result: it is the radio reporting who is
        # out there, and clearing your contacts because you cleared a cafe
        # search would be a surprise. geo.RESERVED_LAYERS says which stay.
        kept = {k: v for k, v in geo.read_layers(LAYERS).items()
                if k in geo.RESERVED_LAYERS}
        geo.write_layers(kept, markers=MARKERS, path=LAYERS)
        print("cleared" + (" (kept: %s)" % ", ".join(sorted(kept)) if kept else ""))
        return 0

    lat = lon = None
    place = None
    source = "given"
    if len(args.where) >= 2:
        try:
            lat, lon = float(args.where[0]), float(args.where[1])
        except ValueError:
            lat = lon = None
    if lat is None and args.where:
        place = geo.parse_nominatim(ask_nominatim(" ".join(args.where)))
        if place is None:
            print("pi-poi: no such place: %s" % " ".join(args.where),
                  file=sys.stderr)
            return 1
        lat, lon = place.lat, place.lon
        # Size the search to the place. A ward is not a point: the default
        # 1500m around the centre of 新宿区 misses most of the ward, and around
        # the centre of 東京都 it lands in an arbitrary field. Only when the
        # radius was not asked for explicitly -- an explicit --radius is the
        # caller saying they know better.
        if not radius_given:
            sized = place.radius_m()
            if sized:
                args.radius = sized
                source = "place"
        # No flyTo here: the fit below goes to the results, which is a better
        # answer than the place's own centre and is where they actually are.
    if lat is None and args.here:
        # Skip the map's last flyTo: "cafes near me" means the ground under the
        # deck, and the map may have been sent somewhere else entirely.
        found = geo.where_now(flyto=None, gps=GPS, home=HOME)
        if found is None:
            print("pi-poi: no recent GPS fix and no PI_POI_HOME; cannot tell "
                  "where 'here' is", file=sys.stderr)
            return 1
        lat, lon, source = found
    if lat is None:
        here = geo.where_now(flyto=FLYTO, gps=GPS, home=HOME)
        if here is None:
            print("pi-poi: nowhere to look -- the map has not been anywhere, "
                  "there is no GPS fix, and PI_POI_HOME is unset. "
                  "Name a place.", file=sys.stderr)
            return 1
        lat, lon, source = here

    try:
        query = geo.overpass_query(args.category, lat, lon, args.radius)
    except ValueError as exc:
        print("pi-poi: %s" % exc, file=sys.stderr)
        return 2

    body = ask_overpass(query)
    key = geo.canonical_category(args.category) or args.category
    lines = geo.marker_lines(body, int(time.time()), limit=args.limit,
                             slot=geo.colour_slot(args.category))

    # Replace this category, keep the others. Searching cafes twice should not
    # leave two overlapping sets of cafes, and should not remove the hotels.
    geo.update_layer(key, lines, markers=MARKERS, path=LAYERS)

    # Fit the camera to what was just found, not to everything on the map: the
    # answer to the question just asked is what should be on screen. Both sets
    # usually stay visible anyway, because a second search runs from the same
    # centre and the same radius.
    fitted = ""
    focus = geo.focus_of(lines, keep=args.keep)
    if focus and not args.no_fit:
        clat, clon, south, north, west, east = focus
        zoom = geo.fit_zoom(south, north, west, east,
                            max_zoom=args.max_zoom)
        with open(FLYTO, "w") as fh:
            fh.write("%.6f %.6f %d\n" % (clat, clon, zoom))
        fitted = ", fit z%d" % zoom

    n = len(lines.splitlines()) if lines else 0
    # Say when the answer was cut short. 200 hotels in 台東区 is the limit
    # talking, not the ward, and a count that silently means "at least this
    # many" is the kind of number people go on to reason with.
    capped = " (capped at %d)" % args.limit if n >= args.limit else ""
    if args.json:
        print(json.dumps({"category": key, "lat": lat, "lon": lon,
                          "radius": args.radius, "count": n,
                          "from": source, "slot": geo.colour_slot(key),
                          "capped": bool(capped),
                          "layers": sorted(geo.read_layers(LAYERS))}))
    else:
        print("%d%s %s around %.4f %.4f (r=%dm, from %s%s) [on the map: %s]"
              % (n, capped, key, lat, lon, args.radius, source, fitted,
                 ", ".join(sorted(geo.read_layers(LAYERS))) or "nothing"))
    return 0


if __name__ == "__main__":
    sys.exit(main())

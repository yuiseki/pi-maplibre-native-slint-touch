#!/usr/bin/env python3
"""pi-zoom: put the map on a thing that has a name.

    pi-zoom 広島駅
    pi-zoom 広島国際会議場
    pi-zoom "Hiroshima Station"

This is the thing behind "広島駅にズームして". It is a different lookup from
pi-geocode, and that is the whole reason it exists: this deck's Nominatim was
imported with IMPORT_STYLE=admin, so it holds administrative areas and nothing
else. 広島駅 comes back from it as 广益街道, a suburb in China, and
広島国際会議場 comes back as nothing at all. Overpass has both.

So: ask Overpass for a feature with that exact name, near where the map is
already looking, widening once if that finds nothing. Near-first is not just
speed -- it is the disambiguation. "駅にズーム" after flying to Hiroshima means
the one in Hiroshima, and a planet-wide name search would have to guess.
"""
import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "pi-hear"))
sys.path.append("/home/yuiseki/src/pi-hear")
import geo  # noqa: E402

OVERPASS = os.environ.get("PI_POI_OVERPASS", "http://127.0.0.1:8002")
NOMINATIM = os.environ.get("PI_GEOCODE_URL", "http://127.0.0.1:8001")
MARKERS = os.environ.get("PI_POI_MARKERS", "/dev/shm/pi-mesh-nodes")
LAYERS = os.environ.get("PI_POI_LAYERS", "/dev/shm/pi-poi-layers.json")
FLYTO = os.environ.get("PI_MAP_FLYTO", "/dev/shm/pi-map-flyto")
GPS = os.environ.get("PI_POI_GPS", "/dev/shm/pi-gps-lastfix")

# Near first, then wide. 30km covers a city and its suburbs, which is what
# "the station" means when you are looking at a city.
#
# 400km is the second guess, chosen by measurement rather than roundness:
# Hiroshima to Kyoto is 311km, and at 300km 「京都駅にズームして」from Hiroshima
# found nothing while the same words in Kyoto worked.
#
# Treat it as a hint, not a bound. This Overpass honours `around` strictly for
# the tag-filtered query (東京 as a railway=station is refused at 400km from
# Hiroshima, correctly) and loosely for the plain name query (東京駅 comes back
# from 682km away). Why is not understood. It does not matter much, because
# pick() sorts by distance from where the map is looking, so a leak costs a
# slower query rather than a wrong answer -- the nearest match still wins.
RADII = (30000, 400000)

# The layer these land in, so that "clear the map" takes them off with
# everything else rather than leaving one orphan pin behind.
LAYER = "zoom"

# OSM Japan does not put 駅 in a station's name. 京都駅 is tagged name=京都 with
# railway=station, and asking for the name as spoken finds nothing at all --
# not at 300km, not at 1000km. 広島駅 does match, but only because tram and bus
# stops beside it are named that way; the station itself is name=広島.
#
# So when the name as spoken finds nothing, drop the suffix and ask for the
# kind of thing instead. The suffix is what says which kind.
SUFFIX_TAGS = {
    "駅": ("railway", "station"),
    "空港": ("aeroway", "aerodrome"),
    "港": ("amenity", "ferry_terminal"),
    "大学": ("amenity", "university"),
    "城": ("historic", "castle"),
    "神社": ("amenity", "place_of_worship"),
    "寺": ("amenity", "place_of_worship"),
    "公園": ("leisure", "park"),
}

# The same idea in English, for when the deck is listening in English. Matched
# as whole words, which Japanese does not need and Latin does: "Preston" ends in
# "ston" and "Newport" in "port", and a substring rule would turn half of
# England into a railway station.
EN_SUFFIX_TAGS = {
    "ferry terminal": ("amenity", "ferry_terminal"),
    "station": ("railway", "station"),
    "airport": ("aeroway", "aerodrome"),
    "port": ("amenity", "ferry_terminal"),
    "university": ("amenity", "university"),
    "castle": ("historic", "castle"),
    "shrine": ("amenity", "place_of_worship"),
    "temple": ("amenity", "place_of_worship"),
    "park": ("leisure", "park"),
}


def split_suffix(name):
    """(stem, (key, value)) when the name says what kind of thing it is.

    None when it does not, or when the suffix is the whole name: "station" on
    its own would leave an empty stem and match every station in range.
    """
    name = (name or "").strip()
    for suffix, kv in SUFFIX_TAGS.items():
        if name.endswith(suffix) and len(name) > len(suffix):
            return name[:-len(suffix)].strip(), kv
    low = name.lower()
    for suffix, kv in EN_SUFFIX_TAGS.items():
        if low.endswith(" " + suffix):
            return name[:-(len(suffix) + 1)].strip(), kv
    return None


def ask_overpass(query, timeout=60):
    url = OVERPASS.rstrip("/") + "/api/interpreter"
    data = urllib.parse.urlencode({"data": query}).encode()
    with urllib.request.urlopen(url, data=data, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


def quote(s):
    """Escape for Overpass QL. The name came out of a microphone and QL is a
    language; a stray quote is a syntax error at best."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def name_variants(name):
    """The spellings worth asking for, in order, without duplicates.

    Exact matches only. Overpass serves ["name"="X"] from an index and a regex
    from a scan, and the wide search is 400km across; the case-insensitive
    regex this started as is the difference between a lookup and a sweep, and
    it timed the real Overpass out.

    So the capitalisation is enumerated instead. whisper writes what it hears
    ("hiroshima station" as readily as "Hiroshima Station") while OSM's name:en
    follows its own convention, and only the two agreeing finds anything. On
    Japanese every variant collapses to the same string and the list is one long.
    """
    out = []
    for v in (name, name.title(), name.capitalize()):
        if v and v not in out:
            out.append(v)
    return out


def name_clauses(name, extra, radius, lat, lon):
    """One clause per (name key, spelling) pair.

    OSM Japan files a station under its Japanese name -- Hiroshima's is
    name=広島, railway=station -- with name:en alongside, and neither contains
    the word "Station". So an English request has to ask name:en; asking both
    keys keeps one code path for both languages.
    """
    return "".join(
        'nwr%s["%s"="%s"](around:%d,%.6f,%.6f);'
        % (extra, key, quote(v), radius, lat, lon)
        for key in ("name", "name:en")
        for v in name_variants(name))


def find_named_query(name, lat, lon, radius, timeout=60):
    return ('[out:json][timeout:%d];(%s);out center 20;'
            % (timeout, name_clauses(name, "", radius, lat, lon)))


def find_named(name, lat, lon, radius, timeout=60):
    """Features with this name within `radius` of lat/lon."""
    return _ask(find_named_query(name, lat, lon, radius, timeout), timeout)


def find_by_kind_query(stem, kv, lat, lon, radius, timeout=60):
    key, value = kv
    extra = '["%s"="%s"]' % (key, value)
    return ('[out:json][timeout:%d];(%s);out center 20;'
            % (timeout, name_clauses(stem, extra, radius, lat, lon)))


def find_by_kind(name, lat, lon, radius, timeout=60):
    """The suffix says what kind of thing; the rest is the name it is filed
    under. Returns [] when the name has no suffix we know."""
    split = split_suffix(name)
    if not split:
        return []
    stem, kv = split
    return _ask(find_by_kind_query(stem, kv, lat, lon, radius, timeout), timeout)


def _ask(q, timeout):
    try:
        return ask_overpass(q, timeout=timeout + 10).get("elements", [])
    except Exception as exc:                       # noqa: BLE001
        print("pi-zoom: overpass: %s" % exc, file=sys.stderr)
        return []


def centre_of(el):
    c = el.get("center") or el
    lat, lon = c.get("lat"), c.get("lon")
    return (float(lat), float(lon)) if lat is not None and lon is not None else None


def pick(elements, lat, lon):
    """One feature out of several, and the extent of the group.

    A station is a node, a platform, a building and a relation all with the
    same name; 広島駅 came back as five nodes inside 200m. They are one place,
    so the answer is the group: centre on the closest, size the view to all of
    them. A relation or way is preferred as the anchor because it has real
    extent, where a node is somebody's guess at the middle.
    """
    pts = [(el, centre_of(el)) for el in elements]
    pts = [(el, c) for el, c in pts if c]
    if not pts:
        return None
    rank = {"relation": 0, "way": 1, "node": 2}

    def key(item):
        el, (elat, elon) = item
        return (rank.get(el.get("type"), 3),
                (elat - lat) ** 2 + (elon - lon) ** 2)

    best_el, best_c = min(pts, key=key)
    lats = [c[0] for _, c in pts]
    lons = [c[1] for _, c in pts]
    return best_el, best_c, (min(lats), max(lats), min(lons), max(lons))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("name", nargs="+", help="the name of the thing")
    ap.add_argument("--near", nargs=2, type=float, metavar=("LAT", "LON"),
                    help="search around here instead of where the map is")
    ap.add_argument("--radius", type=int, default=0,
                    help="metres; 0 tries %s in turn"
                         % ", ".join(str(r) for r in RADII))
    ap.add_argument("--no-pin", action="store_true",
                    help="fly there without marking what was found")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    name = " ".join(args.name).strip()
    if not name:
        print("pi-zoom: nothing named", file=sys.stderr)
        return 2

    if args.near:
        lat, lon = args.near
    else:
        here = geo.where_now(flyto=FLYTO, gps=GPS, home="")
        if here is None:
            print("pi-zoom: the map has not been anywhere and there is no GPS "
                  "fix, so there is no 'near' to search. Name a place first.",
                  file=sys.stderr)
            return 1
        lat, lon = here[0], here[1]

    found = None
    elements = []
    for radius in ([args.radius] if args.radius else RADII):
        # The name as spoken first: when it is filed that way, it is the exact
        # answer. Only then the kind-of-thing fallback, which is looser by
        # construction -- there is more than one 京都 in Kyoto.
        for lookup in (find_named, find_by_kind):
            elements = lookup(name, lat, lon, radius)
            found = pick(elements, lat, lon)
            if found:
                break
        if found:
            used = radius
            break

    if not found:
        print("pi-zoom: nothing called %r within %dkm"
              % (name, RADII[-1] // 1000), file=sys.stderr)
        return 1

    el, (flat, flon), box = found
    zoom = geo.fit_zoom(*box)
    with open(FLYTO, "w") as fh:
        fh.write("%.6f %.6f %d\n" % (flat, flon, zoom))

    if not args.no_pin:
        # One marker, in its own layer, so "clear the map" takes it too.
        line = "poi%d-zoom %.6f %.6f %d %s" % (
            geo.colour_slot(LAYER), flat, flon, int(time.time()),
            name.replace(" ", "_"))
        geo.update_layer(LAYER, line, markers=MARKERS, path=LAYERS)

    if args.json:
        print(json.dumps({"name": name, "lat": flat, "lon": flon,
                          "zoom": zoom, "type": el.get("type"),
                          "id": el.get("id"), "matches": len(elements),
                          "radius": used}))
    else:
        print("%s at %.5f %.5f (z%d, %s/%s, %d match%s within %dkm)"
              % (name, flat, flon, zoom, el.get("type"), el.get("id"),
                 len(elements), "" if len(elements) == 1 else "es",
                 used // 1000))
    return 0


if __name__ == "__main__":
    sys.exit(main())

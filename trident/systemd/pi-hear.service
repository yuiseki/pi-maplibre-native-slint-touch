[Unit]
Description=pi-hear (Trident voice: wake word + place -> map flyTo via /dev/shm)
# Wait for ALSA so the USB mic PCM exists; restart covers a slow enumeration.
After=multi-user.target sound.target
Wants=sound.target

[Service]
Type=simple
User=yuiseki
WorkingDirectory=/home/yuiseki/src/pi-hear
# whisper-cli lives in the whisper.cpp build dir (not on the unit's minimal PATH);
# pi-say / pi-flyto are called by absolute path already.
Environment=PATH=/home/yuiseki/src/whisper.cpp/build/bin:/usr/local/bin:/usr/bin:/bin
Environment=LC_ALL=C.UTF-8 LANG=C.UTF-8
# Which mic to listen to. Referenced by CARD name (not index) so a reboot's
# USB enumeration order can't break it. Overridden per host in
# /etc/default/pi-hear: the deck has four USB ports, so which mic is attached
# is a daily decision, and pointing at an absent one is not a quiet fallback
# but a restart loop -- arecord exits, pi-hear exits with it, forever.
Environment=PI_HEAR_DEVICE=plughw:CARD=Device,DEV=0
# Which model (PI_HEAR_MODEL). It travels with the language rather than
# with the build: the multilingual base reads Japanese well but refuses
# Japanese-accented English outright, answering with whisper's
# "(speaking in foreign language)" placeholder. A deck spoken to mainly in
# English wants ggml-small-q8_0.bin and a reply that takes about 5s
# instead of 2.6s. Set it in /etc/default/pi-hear.
Environment=PI_HEAR_MODEL=/home/yuiseki/src/whisper.cpp/models/ggml-base.bin
# Which language to listen in (PI_HEAR_LANG). Everyday use is Japanese; a demo
# to an English-speaking audience is a line in this file and a restart. The
# leading "-" means the file is optional.
EnvironmentFile=-/etc/default/pi-hear
# The language is in its own file because pi-lang writes it, including from a
# voice command. Listed second so it wins: a spoken switch should outrank what
# was configured by hand, and the hand-written file is where everything that is
# *not* reachable by voice lives.
EnvironmentFile=-/etc/default/pi-hear-lang
# Empty --whisper-prompt = no initial-prompt biasing (intentional).
ExecStart=/home/yuiseki/.venv-ahear/bin/python /home/yuiseki/src/pi-hear/pi_hear.py \
  --engine whisper \
  --whisper-model ${PI_HEAR_MODEL} \
  --whisper-prompt "" \
  --alsa-device ${PI_HEAR_DEVICE} \
  --samplerate 16000 \
  --threshold 0.08 \
  --min-speech 0.5 \
  --act
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
